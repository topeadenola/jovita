// The Jovita app on Cloudflare Workers (static assets).
// Wrangler builds the app first (npm run build → dist/), then uploads dist/.
// Unknown paths like /p/<token>, /g/<token> and /spotlight fall back to index.html, so the app's own router handles them.
{
  "name": "jovita-app",
  "compatibility_date": "2025-09-01",
  "build": { "command": "npm run build" },
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
