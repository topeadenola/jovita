// The Jovita app on Cloudflare Workers.
// Wrangler builds the app first (npm run build → dist/), then uploads dist/.
// Unknown paths like /p/<token>, /g/<token> and /spotlight fall back to index.html, so the app's own router handles them.
// Only /dl/* runs worker/app.js: it downloads gallery originals from R2 (bucket jovita-media) with their own file names.
{
  "name": "jovita-app",
  "compatibility_date": "2025-09-01",
  "main": "worker/app.js",
  "build": { "command": "npm run build" },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/dl/*"]
  },
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "jovita-media" }]
}
