# Jovita app (app.getjovita.com, studio addresses, own domains): security headers on every page,
# and keep it all out of Google (dashboards, client pages, invoices and galleries are private).
/*
  X-Robots-Tag: noindex, nofollow
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Permissions-Policy: camera=(), microphone=(self), geolocation=(), payment=(self), usb=(), interest-cohort=()
  Content-Security-Policy: frame-ancestors 'self'; base-uri 'self'; object-src 'none'; upgrade-insecure-requests
  Cross-Origin-Opener-Policy: same-origin-allow-popups

# Spotlight (the public showcase of studios) is meant to be found
/spotlight
  ! X-Robots-Tag
/spotlight/*
  ! X-Robots-Tag

# The website copy bundled with the app is served from getjovita.com, not here
/landing/*
  X-Robots-Tag: noindex, nofollow
