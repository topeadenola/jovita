// The Jovita website (getjovita.com) on Cloudflare Workers. Plain static files, no build step.
// In Cloudflare: root directory public/landing, build command empty, deploy command `npx wrangler deploy`.
{
  "name": "jovita",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": ".",
    "not_found_handling": "404-page"
  }
}
